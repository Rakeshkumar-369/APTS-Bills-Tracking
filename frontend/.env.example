# Optional. Leave unset to call the API on the same origin (/api).
# In development Vite proxies /api to the backend (see vite.config.js).
# VITE_API_BASE_URL=/api

# Optional: where the dev-server proxy sends /api (default http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000

# Optional: sign users out after this many minutes without activity (default 30)
# VITE_IDLE_TIMEOUT_MINUTES=30
