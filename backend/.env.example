# Copy to backend/.env and fill in. NEVER commit the real .env file.

# ── Server ──
NODE_ENV=development          # development | production
HOST=127.0.0.1                # 0.0.0.0 to listen on all interfaces
PORT=5000
# Behind Nginx / a load balancer: set so rate limiting & audit logs see the real
# client IP, e.g. TRUST_PROXY=loopback   (or 1 = one proxy hop)
TRUST_PROXY=

# ── Database ──
DB_HOST=127.0.0.1             # private IP of the MySQL server in production
DB_PORT=3306
DB_USER=apts_app              # a dedicated user with rights ONLY on DB_NAME (not root)
DB_PASSWORD=
DB_NAME=apts_bills_tracking

# ── SSL for MySQL connection ──
DB_SSL=false                  # true in production
DB_SSL_CA_PATH=               # e.g. ./certs/ca.pem

# ── JWT ──
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use two DIFFERENT long random values.
JWT_SECRET=
JWT_EXPIRES_IN=15m            # access token lifetime
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=8h   # absolute session lifetime (user must log in again after this)

# ── Frontend ──
FRONTEND_ORIGIN=http://localhost:5173   # production: https://your-domain

# ── Optional tuning ──
MAX_UPLOAD_MB=25              # per-file upload limit
RATE_LIMIT_AUTH_MAX=20        # login attempts per IP per 15 minutes
RATE_LIMIT_API_MAX=600        # API requests per IP per minute
